# pb-talk configuration.
#
# Copy this file to `.env` in the directory where you run `pbtalk`,
# or set $PB_TALK_ENV_FILE to its path.
#
# Required:
PB_APP_ID=your-app-id
PB_USER_KEY=your-user-key
PB_BOTNAME=your-botname

# Optional:

# API host. Defaults to https://api.pandorabots.com if unset.
#PB_HOST=https://api.pandorabots.com

# Bot key for `--atalk`. When set, pbtalk's --atalk uses
# POST /atalk?botkey=... (the bot key identifies the bot;
# PB_APP_ID and PB_BOTNAME are not used for atalk requests).
#PB_BOT_KEY=your-bot-key

# Optional client_name passed to talk requests. If unset,
# pbtalk lets the server allocate one on first atalk reply.
#PB_CLIENT_NAME=

# Word segmentation hook command name. pbtalk calls this command
# (with the input string as argv[1]) when the `seg` toggle is on.
# Default: pbseg. Provide your own implementation in PATH.
# See README.ja.md for examples (Japanese-language users).
#PB_SEG_CMD=pbseg
